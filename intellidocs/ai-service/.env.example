# --- AI service configuration ---
# Copy this file to `.env` and fill in values as needed.

# Embedding model (Hugging Face sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths (relative to ai-service/ directory)
DATA_DIR=./data
CHROMA_DIR=./faiss_index

# LLM provider (set in Day 5-6). One of: groq | openai | anthropic | local | ollama | finetuned
LLM_PROVIDER=groq

# Groq (if LLM_PROVIDER=groq) — OpenAI-compatible API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama (if LLM_PROVIDER=ollama) — Local model serving
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Fine-tuned model (if LLM_PROVIDER=finetuned) — Week 4
# Create with: python -m finetune.quantize_export
FINETUNED_MODEL=intellidocs-finetuned

# Retrieval mode (Week 4: hybrid search)
# vector = FAISS only, hybrid = keyword + vector (MongoDB text index + FAISS)
RETRIEVAL_MODE=vector

# CORS - comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost:3000,http://localhost
# Production: https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost