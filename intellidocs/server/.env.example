# --- Express backend configuration ---
# Copy to `.env` and adjust as needed.

PORT=5000

# MongoDB connection string (local default)
MONGODB_URI=mongodb://localhost:27017/intellidocs

# URL of the AI microservice (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# JWT secret for authentication (CHANGE IN PRODUCTION!)
# MUST be set - no default fallback in production code
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS - comma-separated list of allowed client origins
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173,http://localhost:3000