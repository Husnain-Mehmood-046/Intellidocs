# --- Client configuration ---
# Copy this file to `.env` and fill in values as needed.
# For Vite, variables must be prefixed with VITE_ to be exposed to the client.

# API base URL (used by chatApi.js)
# Development: http://localhost:5000/api (proxied by Vite)
# Production: https://your-server.onrender.com/api
VITE_API_URL=http://localhost:5000/api